{
  "name": "pc-connect",
  "version": "2.4.2",
  "description": "PC Connect - 屏幕共享工具",
  "main": "./out/main/index.js",
  "author": {
    "name": "PC Connect"
  },
  "license": "MIT",
  "scripts": {
    "tools": "node scripts/fetch-tools.mjs",
    "postinstall": "node scripts/fetch-tools.mjs",
    "dev": "npm run tools && electron-vite dev",
    "build": "npm run tools && electron-vite build",
    "start": "electron-vite preview",
    "translations": "typesafe-i18n --no-watch",
    "translations:watch": "typesafe-i18n",
    "build:win": "npm run tools && electron-vite build && electron-builder --win --publish never",
    "build:mac": "npm run tools && electron-vite build && electron-builder --mac --publish never",
    "build:linux": "npm run tools && electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "3.0.0",
    "@sweetalert2/theme-bulma": "5.0.18",
    "electron-settings": "4.0.4",
    "hls.js": "^1.7.0",
    "obs-websocket-js": "^5.0.8",
    "sweetalert2": "^11.26.25",
    "typesafe-i18n": "5.26.2"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.6.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "bulma": "1.0.2",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "svelte": "^5.56.9",
    "typescript": "^5.5.2",
    "vite": "^7.3.6"
  },
  "overrides": {
    "crypto-js": "^4.2.0"
  }
}
